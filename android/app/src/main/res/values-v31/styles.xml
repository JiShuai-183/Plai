<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12(API 31) 起由系统接管启动闪屏：背景取 windowSplashScreenBackground，
     不设则回落 windowBackground（可能闪白）。这里显式指定品牌主绿，
     与 drawable/launch_background 保持一致。仅覆盖 LaunchTheme，其余继承默认。 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
