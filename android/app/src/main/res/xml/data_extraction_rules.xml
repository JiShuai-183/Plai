<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+：云备份和设备迁移均不得带走教务凭据。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="plai_eams_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:plai_eams_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:plai_eams_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="plai_eams_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:plai_eams_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:plai_eams_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
